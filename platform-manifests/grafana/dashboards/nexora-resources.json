        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Memory % of limit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"nexora\", container!=\"\", container!=\"POD\", container!=\"istio-proxy\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"nexora\", container!=\"istio-proxy\", resource=\"memory\"})",
          "legendFormat": "{{pod}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
